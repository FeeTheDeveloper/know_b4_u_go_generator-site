# Copy to .env.local for local development.
# Set these two on Vercel (Project → Settings → Environment Variables) for production.

# Public — safe to expose to the browser. From Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional — used only by scripts you may add later (server-side migrations, cron jobs).
# DO NOT prefix with NEXT_PUBLIC and DO NOT set on the client.
# SUPABASE_SERVICE_ROLE_KEY=...
